\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces \textbf  {Models fail under pressure in three categorically different ways.} Each model's change in endorsement ($\Delta $BER from control, $x$-axis) plotted against its change in refusal rate ($\Delta $refusal, $y$-axis) at $T{=}0$. Three clusters emerge: \emph  {endorsement-dominant} (high $\Delta $BER, low $\Delta $refusal), \emph  {refusal-dominant} (low $\Delta $BER, high $\Delta $refusal), and \emph  {context-insensitive} (near origin). Colors indicate architecture family.\relax }}{24}{figure.caption.42}\protected@file@percent }
\newlabel{fig:taxonomy}{{9}{24}{\textbf {Models fail under pressure in three categorically different ways.} Each model's change in endorsement ($\Delta $BER from control, $x$-axis) plotted against its change in refusal rate ($\Delta $refusal, $y$-axis) at $T{=}0$. Three clusters emerge: \emph {endorsement-dominant} (high $\Delta $BER, low $\Delta $refusal), \emph {refusal-dominant} (low $\Delta $BER, high $\Delta $refusal), and \emph {context-insensitive} (near origin). Colors indicate architecture family.\relax }{figure.caption.42}{}}
