\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Pillar\nobreakspace  {}II: DPO penalizes content copying but not literal repetition runs.} Effect-size forest plot over all nine delta metrics ($N{=}259{,}785$ pairs), with 95\% bootstrap CIs and Holm-corrected markers (filled blue: $p_{\text  {Holm}}{<}0.05$). Null-distribution $z$ scores annotate each row. The Romano et al.\nobreakspace  {}(2006) ``none'' band ($|\delta |{<}0.147$, grey) is shown for reference; directional sign is the more honest readout at this $N$. Violin distributions for four representative metrics are in Appendix\nobreakspace  {}\ref  {app:pillar2_violins}.\relax }}{7}{figure.caption.15}\protected@file@percent }
\newlabel{fig:pillar2_effect}{{3}{7}{\textbf {Pillar~II: DPO penalizes content copying but not literal repetition runs.} Effect-size forest plot over all nine delta metrics ($N{=}259{,}785$ pairs), with 95\% bootstrap CIs and Holm-corrected markers (filled blue: $p_{\text {Holm}}{<}0.05$). Null-distribution $z$ scores annotate each row. The Romano et al.~(2006) ``none'' band ($|\delta |{<}0.147$, grey) is shown for reference; directional sign is the more honest readout at this $N$. Violin distributions for four representative metrics are in Appendix~\ref {app:pillar2_violins}.\relax }{figure.caption.15}{}}
