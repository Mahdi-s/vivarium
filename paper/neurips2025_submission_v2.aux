\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {The SFT-up, DPO-down shape generalizes across conditions.} BER ($N{=}400$, $T{=}0$) for each OLMo-3 checkpoint $\times $ condition cell. \emph  {Top:} the Instruct path on all 12 conditions (control, 8 peer-consensus, 3 authority). Instruct-SFT (row 2) is uniformly the warmest row across peer conditions (peaking at $0.75$ on \texttt  {unan\_neutral}); Instruct-DPO (row 3) drops sharply, with Instruct (RLVR, row 4) partially re-rising. \emph  {Bottom:} the Think path on the four shared conditions, with the same SFT-up, DPO-down shape at a lower absolute level. Columns are aligned across panels for direct comparison. \emph  {Note (HPC re-run pending).} Panel B currently shows only the four conditions for which Think-pipeline data was available at submission. A Panel B extension covering the eight remaining conditions (\texttt  {asch\_history\_5}, \texttt  {diverse\_plain}, \texttt  {qd}, \texttt  {da}, \texttt  {unanimous\_plain}, \texttt  {unanimous\_neutral}, \texttt  {unanimous\_uncertain}, \texttt  {authority\_trust\_da}) is in progress on HPC for Think-SFT, Think-DPO, and Think-RLVR at both 7B and 32B; once those return, Panel B will be expanded to a 6$\times $12 row-for-row analog of Panel A and the caption updated. See \texttt  {.claude/plans/below-is-feedback-from-golden-sphinx.md} for the experiment plan.\relax }}{10}{figure.caption.25}\protected@file@percent }
\newlabel{fig:heatmap}{{4}{10}{\textbf {The SFT-up, DPO-down shape generalizes across conditions.} BER ($N{=}400$, $T{=}0$) for each OLMo-3 checkpoint $\times $ condition cell. \emph {Top:} the Instruct path on all 12 conditions (control, 8 peer-consensus, 3 authority). Instruct-SFT (row 2) is uniformly the warmest row across peer conditions (peaking at $0.75$ on \texttt {unan\_neutral}); Instruct-DPO (row 3) drops sharply, with Instruct (RLVR, row 4) partially re-rising. \emph {Bottom:} the Think path on the four shared conditions, with the same SFT-up, DPO-down shape at a lower absolute level. Columns are aligned across panels for direct comparison. \emph {Note (HPC re-run pending).} Panel B currently shows only the four conditions for which Think-pipeline data was available at submission. A Panel B extension covering the eight remaining conditions (\texttt {asch\_history\_5}, \texttt {diverse\_plain}, \texttt {qd}, \texttt {da}, \texttt {unanimous\_plain}, \texttt {unanimous\_neutral}, \texttt {unanimous\_uncertain}, \texttt {authority\_trust\_da}) is in progress on HPC for Think-SFT, Think-DPO, and Think-RLVR at both 7B and 32B; once those return, Panel B will be expanded to a 6$\times $12 row-for-row analog of Panel A and the caption updated. See \texttt {.claude/plans/below-is-feedback-from-golden-sphinx.md} for the experiment plan.\relax }{figure.caption.25}{}}
\@writefile{toc}{\contentsline {section}{\numberline {C}Ablation Figure: N-gram vs.\ Social Conditions}{11}{appendix.C}\protected@file@percent }
\newlabel{app:ablation_figure}{{C}{11}{Ablation Figure: N-gram vs.\ Social Conditions}{appendix.C}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Four-condition ablation: Llama-3.1-70B ($T{=}0.0$, $N{=}400$).} BER under four conditions, left to right. (1)\nobreakspace  {}\textbf  {Social + system prompt} (blue): $4.5\%$, but $89\%$ refusal rate---protection is refusal-based abstention, not corrected answering. (2)\nobreakspace  {}\textbf  {Naked social} (orange): $27.8\%$; social Asch-style pressure without the system prompt, instruction reads ``Answer the question based on your knowledge.'' (3)\nobreakspace  {}\textbf  {N-gram, matched instruction} (green): $27.8\%$; identical repetition structure, no social framing, same instruction stem as (2). Social framing accounts for zero additional endorsement once instruction wording is held constant. (4)\nobreakspace  {}\textbf  {N-gram, original wording} (red): $36.5\%$; same structure but instruction reads ``Answer the following question based on the provided sequence,'' explicitly directing the model to the in-context sequence. The ${\approx }9$-point gap between (3) and (4) is an instruction-wording effect (\S  \ref  {sec:ablation}), not a social one. Error bars show Wilson 95\% CIs. OLMo-3.1-32B-Instruct matched-instruction condition is pending (see body text).\relax }}{11}{figure.caption.26}\protected@file@percent }
\newlabel{fig:ablation}{{5}{11}{\textbf {Four-condition ablation: Llama-3.1-70B ($T{=}0.0$, $N{=}400$).} BER under four conditions, left to right. (1)~\textbf {Social + system prompt} (blue): $4.5\%$, but $89\%$ refusal rate---protection is refusal-based abstention, not corrected answering. (2)~\textbf {Naked social} (orange): $27.8\%$; social Asch-style pressure without the system prompt, instruction reads ``Answer the question based on your knowledge.'' (3)~\textbf {N-gram, matched instruction} (green): $27.8\%$; identical repetition structure, no social framing, same instruction stem as (2). Social framing accounts for zero additional endorsement once instruction wording is held constant. (4)~\textbf {N-gram, original wording} (red): $36.5\%$; same structure but instruction reads ``Answer the following question based on the provided sequence,'' explicitly directing the model to the in-context sequence. The ${\approx }9$-point gap between (3) and (4) is an instruction-wording effect (\S \ref {sec:ablation}), not a social one. Error bars show Wilson 95\% CIs. OLMo-3.1-32B-Instruct matched-instruction condition is pending (see body text).\relax }{figure.caption.26}{}}
