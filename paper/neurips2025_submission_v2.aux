\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces \textbf  {BER by knowledge domain under unanimous-confident peer pressure vs.\ control, Olmo-3-7B Instruct-pipeline variants, with Wilson 95\% CIs.} Values pooled across 6 temperatures. $n$ is the per-cell sample size (each (variant, condition, domain) cell pools 6 temperatures times domain item counts). CIs are wide on the low-BER control cells (Math, Preference) by Wilson construction and do not invalidate the positive $\Delta $'s, whose magnitudes far exceed the CI widths. The qualitative pattern from the main text holds under this accounting: Instruct-SFT shows the largest pressure BER in every domain, with non-overlapping CIs versus Instruct-DPO in Math, Science, and History/Geo.\relax }}{19}{table.caption.34}\protected@file@percent }
\newlabel{tab:domain_breakdown}{{5}{19}{\textbf {BER by knowledge domain under unanimous-confident peer pressure vs.\ control, Olmo-3-7B Instruct-pipeline variants, with Wilson 95\% CIs.} Values pooled across 6 temperatures. $n$ is the per-cell sample size (each (variant, condition, domain) cell pools 6 temperatures times domain item counts). CIs are wide on the low-BER control cells (Math, Preference) by Wilson construction and do not invalidate the positive $\Delta $'s, whose magnitudes far exceed the CI widths. The qualitative pattern from the main text holds under this accounting: Instruct-SFT shows the largest pressure BER in every domain, with non-overlapping CIs versus Instruct-DPO in Math, Science, and History/Geo.\relax }{table.caption.34}{}}
